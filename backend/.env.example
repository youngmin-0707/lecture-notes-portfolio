# 이 파일을 복사해 `.env`로 사용하세요: cp .env.example .env
# 실사용(로컬 개인 도구) 기본값 예시입니다.

ENVIRONMENT=development

# --- DB (§0 D9) --- 실사용은 로컬 SQLite. docker 등 별도 인프라가 필요 없습니다.
DATABASE_URL=sqlite:///./data/lecture_notes.db

# --- 네트워크 바인딩 (§3.7, US-11) ---
# 0.0.0.0으로 바꾸면 서버가 기동을 거부합니다. 개인용 도구이므로 절대 외부에 노출하지 마세요.
BIND_HOST=127.0.0.1
BIND_PORT=8765

# --- 저장 경로 (§2.2) ---
DATA_DIR=data
AUDIO_STORAGE_DIR=data/audio
MODEL_CACHE_DIR=data/models

# 요약까지 끝나면(DONE) 원본 오디오를 지운다(2026-08-29). False로 두면 예전처럼 계속 보관.
DELETE_AUDIO_AFTER_PROCESSING=True

# --- STT (§0 D3, §3.2) ---
STT_PROVIDER=local_whisper
STT_MODEL=large-v3-turbo
STT_LANGUAGE=ko

# --- LLM (§0 D5, §3.4) ---
# 2026-08-29: 로컬 Ollama(qwen3:14b)가 24GB 통합 메모리에서 메모리 압박(swap 발생)과
# 스키마 위반(재요약 실패)을 둘 다 일으켜, 요약 단계만 클라우드(OpenAI)로 옮겼다.
# 로컬 STT(faster-whisper)는 계속 오프라인으로 남는다.
LLM_PROVIDER=openai

# --- OpenAI (요약 전용, 클라우드) ---
# 실제 키는 여기에 절대 커밋하지 말 것 — .env(gitignore됨)에만 넣는다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=120

# --- 로컬 Ollama (더 이상 기본값 아님 — LLM_PROVIDER=ollama로 되돌리면 다시 사용됨) ---
LLM_MODEL=qwen3:14b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=30s
# 60분 강의 전사량을 감안한 컨텍스트 길이(§3.4)와 로컬 모델 응답 대기 한도(초).
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_SECONDS=600
# qwen3의 사고 과정을 켠다. False가 더 빠르지만 요약이 뭉뚱그려지는 경향이 있다(2026-08-29).
OLLAMA_THINK=True
# 사실 기반 구조화 요약의 재현성을 위해 Ollama 기본값(~0.8)보다 낮게 고정.
OLLAMA_TEMPERATURE=0.3

# --- 요약 재시도 정책 (§3.4) --- 429/5xx/타임아웃만 재시도, 4xx는 즉시 실패.
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_SECONDS=1.0

# --- map-reduce 긴 전사 요약 (§3.4, T-21) --- Ollama처럼 컨텍스트 좁은 로컬 모델용 값.
SUMMARY_CHUNK_SIZE_TOKENS=4000
SUMMARY_CHUNK_OVERLAP_TOKENS=200
SUMMARY_MAP_CALL_INTERVAL_SECONDS=1.0
# OpenAI는 컨텍스트가 1.05M 토큰이라 이 앱 최장 강의(240분)도 한 번에 들어간다(2026-08-30).
OPENAI_SUMMARY_CHUNK_SIZE_TOKENS=200000

# --- 무료 티어 대안 (선택, §0 D4/D5) ---
# 값을 채우지 않으면 해당 provider는 사용할 수 없습니다 (LLM_NOT_CONFIGURED / 어댑터 미선택).
# GROQ_API_KEY=
# GEMINI_API_KEY=
