<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lecturenotes.backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/son/개발/lecture-notes/backend/.venv/bin/python</string>
        <string>scripts/backup_db.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/son/개발/lecture-notes/backend</string>
    <!-- 매일 03:00. 그 시각에 잠자기 중이었으면 깨어날 때 실행된다. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/son/개발/lecture-notes/backend/logs/backup.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/son/개발/lecture-notes/backend/logs/backup.err.log</string>
</dict>
</plist>
