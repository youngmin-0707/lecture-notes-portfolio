# 이 파일을 복사해 `.env`로 사용하세요: cp .env.example .env
# 실사용(로컬 개인 도구) 기본값 예시입니다.

ENVIRONMENT=development

# --- DB (§0 D9) --- 실사용은 로컬 SQLite. docker 등 별도 인프라가 필요 없습니다.
DATABASE_URL=sqlite:///./data/lecture_notes.db

# --- 네트워크 바인딩 (§3.7, US-11) ---
# 0.0.0.0으로 바꾸면 서버가 기동을 거부합니다. 개인용 도구이므로 절대 외부에 노출하지 마세요.
BIND_HOST=127.0.0.1
BIND_PORT=8765

# --- 저장 경로 (§2.2) ---
DATA_DIR=data
AUDIO_STORAGE_DIR=data/audio
MODEL_CACHE_DIR=data/models

# --- STT (§0 D3, §3.2) ---
STT_PROVIDER=local_whisper
STT_MODEL=large-v3-turbo
STT_LANGUAGE=ko

# --- LLM (§0 D5, §3.4) ---
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:14b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=30s

# --- 무료 티어 대안 (선택, §0 D4/D5) ---
# 값을 채우지 않으면 해당 provider는 사용할 수 없습니다 (LLM_NOT_CONFIGURED / 어댑터 미선택).
# GROQ_API_KEY=
# GEMINI_API_KEY=
