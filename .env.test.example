# 테스트 실행 시 참고용 환경변수 예시 (docker-compose.test.yml 기준).
# 실제 사용 시 `cp .env.test.example .env.test` 후 값 조정, 또는 쉘 export로 주입.

TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/signup_test
JWT_SECRET=test-secret-key-not-for-production-use
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ENVIRONMENT=test
